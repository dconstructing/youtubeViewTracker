{
  // Widens tsconfig.json's exclude so `tsc --noEmit` here also checks
  // *.test.ts. The build config keeps excluding tests (so `tsc` doesn't
  // emit them into dist/); this config exists only so tests get type-checked
  // somewhere - Vitest itself doesn't (esbuild strips types, no checking).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
