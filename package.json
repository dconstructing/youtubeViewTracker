{
  "name": "youtubeviewtracker",
  "version": "1.0.0",
  "description": "",
  "main": "dist/extract-video-id.js",
  "scripts": {
    "build": "tsc",
    "build:lambda": "tsc -p tsconfig.serverless.json",
    "dev": "tsc --watch",
    "start": "tsc && node dist/cli.js",
    "extract": "tsc && node dist/extract-cli.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "prepare": "husky",
    "deploy:sam": "npm run build:lambda && sam deploy --template-file template-simple.yaml --stack-name youtube-viewership-tracker --capabilities CAPABILITY_IAM --parameter-overrides YouTubeApiKey=$YOUTUBE_API_KEY --profile PowerUserAccess-316490106252 --resolve-s3",
    "deploy:sam:admin": "npm run build:lambda && sam deploy --template-file template-simple.yaml --stack-name youtube-viewership-tracker --capabilities CAPABILITY_IAM --parameter-overrides YouTubeApiKey=$YOUTUBE_API_KEY --profile admin --resolve-s3",
    "dev:cloudflare": "wrangler dev -c wrangler.toml",
    "deploy:cloudflare": "npm test && wrangler deploy -c wrangler.toml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^16.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "test-exclude": "^8"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
